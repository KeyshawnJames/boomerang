    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressSuggestion": {
        "properties": {
          "place_id": {
            "type": "string",
            "title": "Place Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "place_id",
          "text"
        ],
        "title": "AddressSuggestion"
      },
      "AnswerOutcome": {
        "type": "string",
        "enum": [
          "pass",
          "warn",
          "block"
        ],
        "title": "AnswerOutcome"
      },
      "BookingOptions": {
        "properties": {
          "pickup_fee": {
            "type": "integer",
            "title": "Pickup Fee"
          },
          "slots": {
            "items": {
              "$ref": "#/components/schemas/PickupSlot"
            },
            "type": "array",
            "title": "Slots"
          }
        },
        "type": "object",
        "required": [
          "pickup_fee",
          "slots"
        ],
        "title": "BookingOptions"
      },
      "Carrier": {
        "type": "string",
        "enum": [
          "canada_post",
          "ups",
          "purolator",
          "fedex",
          "other"
        ],
        "title": "Carrier"
      },
      "CreateReturnRequest": {
        "properties": {
          "retailer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Retailer Id"
          },
          "carrier": {
            "type": "string",
            "enum": [
              "canada_post",
              "ups",
              "purolator"
            ],
            "title": "Carrier"
          },
          "label_type": {
            "$ref": "#/components/schemas/LabelType"
          },
          "order_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Number"
          },
          "label_photo_key": {
            "type": "string",
            "maxLength": 200,
            "title": "Label Photo Key"
          },
          "package_photo_key": {
            "type": "string",
            "maxLength": 200,
            "title": "Package Photo Key"
          },
          "address_token": {
            "type": "string",
            "maxLength": 2000,
            "title": "Address Token"
          },
          "pickup_notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Notes"
          },
          "asap": {
            "type": "boolean",
            "title": "Asap",
            "default": false
          },
          "pickup_window_start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Window Start"
          },
          "answers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Answers"
          },
          "policy_version": {
            "type": "integer",
            "title": "Policy Version"
          },
          "acknowledged_warnings": {
            "type": "boolean",
            "title": "Acknowledged Warnings",
            "default": false
          },
          "attested": {
            "type": "boolean",
            "title": "Attested",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "retailer_id",
          "carrier",
          "label_type",
          "label_photo_key",
          "package_photo_key",
          "address_token",
          "answers",
          "policy_version"
        ],
        "title": "CreateReturnRequest"
      },
      "EligibilityOutcome": {
        "type": "string",
        "enum": [
          "eligible",
          "eligible_with_warnings"
        ],
        "title": "EligibilityOutcome"
      },
      "EligibilityQuestionRead": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "help": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Help"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/QuestionOption"
            },
            "type": "array",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "code",
          "prompt",
          "help",
          "options"
        ],
        "title": "EligibilityQuestionRead"
      },
      "EligibilityQuestions": {
        "properties": {
          "policy_version": {
            "type": "integer",
            "title": "Policy Version"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/EligibilityQuestionRead"
            },
            "type": "array",
            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "policy_version",
          "questions"
        ],
        "title": "EligibilityQuestions"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LabelType": {
        "type": "string",
        "enum": [
          "qr_code",
          "printed_label"
        ],
        "title": "LabelType"
      },
      "Locale": {
        "type": "string",
        "enum": [
          "fr",
          "en"
        ],
        "title": "Locale"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PickupSlot": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "asap": {
            "type": "boolean",
            "title": "Asap"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end",
          "asap"
        ],
        "title": "PickupSlot"
      },
      "PresignRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "label",
              "package"
            ],
            "title": "Kind"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/heic"
            ],
            "title": "Content Type"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "content_type"
        ],
        "title": "PresignRequest"
      },
      "PresignedUpload": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "key",
          "url"
        ],
        "title": "PresignedUpload"
      },
      "QuestionOption": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "outcome": {
            "$ref": "#/components/schemas/AnswerOutcome"
          }
        },
        "type": "object",
        "required": [
          "value",
          "label",
          "outcome"
        ],
        "title": "QuestionOption"
      },
      "RegisterRequest": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "client",
              "driver"
            ],
            "title": "Role"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale",
            "default": "fr"
          }
        },
        "type": "object",
        "required": [
          "role",
          "name",
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "ResolvedAddress": {
        "properties": {
          "address": {
            "type": "string",
            "title": "Address"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "address",
          "token"
        ],
        "title": "ResolvedAddress"
      },
      "RetailerRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "logo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logo Url"
          },
          "return_policy_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Return Policy Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "logo_url",
          "return_policy_url"
        ],
        "title": "RetailerRead"
      },
      "ReturnRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "$ref": "#/components/schemas/ReturnStatus"
          },
          "retailer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Retailer Id"
          },
          "carrier": {
            "$ref": "#/components/schemas/Carrier"
          },
          "label_type": {
            "$ref": "#/components/schemas/LabelType"
          },
          "order_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Number"
          },
          "pickup_address": {
            "type": "string",
            "title": "Pickup Address"
          },
          "pickup_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Notes"
          },
          "pickup_window_start": {
            "type": "string",
            "format": "date-time",
            "title": "Pickup Window Start"
          },
          "pickup_window_end": {
            "type": "string",
            "format": "date-time",
            "title": "Pickup Window End"
          },
          "pickup_fee": {
            "type": "integer",
            "title": "Pickup Fee"
          },
          "eligibility_outcome": {
            "$ref": "#/components/schemas/EligibilityOutcome"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "retailer_id",
          "carrier",
          "label_type",
          "order_number",
          "pickup_address",
          "pickup_notes",
          "pickup_window_start",
          "pickup_window_end",
          "pickup_fee",
          "eligibility_outcome",
          "created_at"
        ],
        "title": "ReturnRead"
      },
      "ReturnStatus": {
        "type": "string",
        "enum": [
          "awaiting_payment",
          "requested",
          "driver_assigned",
          "picked_up",
          "dropped_off",
          "completed",
          "cancelled",
          "failed_dropoff"
        ],
        "title": "ReturnStatus"
      },
      "Token": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "Token"
      },
      "UpdateMeRequest": {
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 30,
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "UpdateMeRequest"
      },
      "UserRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
