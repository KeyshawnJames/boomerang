# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# These match the docker-compose Postgres service defaults.

# ---- Database ----
DATABASE_URL=postgresql+psycopg://boomerang:boomerang@localhost:5433/boomerang

# ---- API ----
# Browser origins allowed to call the API (JSON list). Native apps don't need this.
CORS_ORIGINS=["http://localhost:8081"]

# ---- Auth (JWT) ----
# Required, at least 32 characters. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Booking (ADR 0012) ----
# Pickup fee in cents, all fees included, before GST/QST. Placeholder until the business sets it.
PICKUP_FEE=499
# Service hours, Montreal time (24h clock).
SERVICE_OPEN_HOUR=9
SERVICE_CLOSE_HOUR=21
# Pickups must be within this many metres of downtown Montreal (ADR 0013).
SERVICE_AREA_RADIUS_M=15000

# ---- Google Places (address lookup, ADR 0013) ----
# Server only, never in the apps. How to create it: docs/development.md.
GOOGLE_MAPS_API_KEY=

# ---- Stripe (test keys only; filled in at milestone M5) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
