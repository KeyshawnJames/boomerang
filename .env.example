# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# These match the docker-compose Postgres service defaults.

# ---- Database ----
DATABASE_URL=postgresql+psycopg://boomerang:boomerang@localhost:5432/boomerang

# ---- Auth (JWT) ----
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Stripe (test keys for now; fill in during Milestone 8) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
